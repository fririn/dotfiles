separator=true
separator_block_width=20

[sway-focusedwindow]
command=/usr/libexec/i3blocks/sway-focusedwindow
interval=persist
color=#555555

[wireless]
command=IF=$(for f in /sys/class/net/*/wireless; do basename "${f%/wireless}"; break; done); [ -z "$IF" ] && exit 0; ip -4 addr show "$IF" 2>/dev/null | grep -q 'inet ' || exit 0; IFACE="$IF" display_wifi_name=1 LABEL=W: /usr/libexec/i3blocks/iface
interval=5

[ethernet]
command=IF=$(for f in /sys/class/net/*; do d=$(basename "$f"); case "$d" in lo|wl*|ww*) continue;; esac; [ -d "$f/wireless" ] && continue; echo "$d"; break; done); [ -z "$IF" ] && exit 0; [ "$(cat /sys/class/net/$IF/operstate 2>/dev/null)" = "up" ] || exit 0; IFACE="$IF" LABEL=E: /usr/libexec/i3blocks/iface
interval=5

[tailscale]
command=command -v tailscale >/dev/null 2>&1 || exit 0; J=$(tailscale status --json 2>/dev/null); STATE=$(echo "$J" | jq -r '.BackendState'); [ "$STATE" = "Running" ] || (echo "tailscale down"; echo "tailscale down"; echo "#FF0000";exit 0); EXIT=$(echo "$J" | jq -r '[.Peer[]? | select(.ExitNode==true) | .HostName][0] // empty'); [ -z "$EXIT" ] && exit 0; echo "Exit: $EXIT"; echo "Exit: $EXIT"; echo "#008800"
interval=10


[powerprofile]
command=~/.config/i3blocks/scripts/powerprofile
interval=once

[load_average]
command=~/.config/i3blocks/scripts/la
interval=5

[memory]
command=/usr/libexec/i3blocks/memory
interval=5

[kubernetes]
command=/usr/libexec/i3blocks/kubernetes
interval=10

[volume]
command=~/.config/i3blocks/scripts/volume
interval=once
signal=10

[battery]
command=/usr/libexec/i3blocks/battery
interval=30
BAT_NUMBER=0

[time]
command=date '+%d.%m %a %H:%M:%S'
interval=1
color=#008800
