-- Hyprland config (Lua, 0.57+). Migrated from hyprland.conf + env.conf + wallust-hyprland.conf.
-- The originals are in backup-hyprlang-2026-11-08/.
-- API reference: /usr/share/hypr/stubs/hl.meta.lua
-- Check after editing: Hyprland --verify-config -c ~/.config/hypr/hyprland.lua

local term = "kitty"
local scriptsDir = "$HOME/.config/hypr/scripts"
local rofiDir = "$HOME/.config/rofi"
local mainMod = "SUPER"

-- Launch apps in their own systemd scope (under app.slice) so systemd-oomd kills the
-- offending app instead of session-N.scope, which holds Hyprland itself.
-- --scope execs in place, so PIDs (and exec workspace rules) are preserved.
local run = "systemd-run --user --scope --slice=app.slice --collect --quiet --"

-- Monitors
local one = "HDMI-A-1"
local two = "eDP-1"

-- From wallust-hyprland.conf (only the two colors the config used)
local color0 = "rgb(4F4F4F)"
local color15 = "rgb(D6D6D6)"

----------------------------------------------------------------------------------
-- ENVIRONMENT
----------------------------------------------------------------------------------
hl.env("EDITOR", "nvim")

-- Toolkit backends
hl.env("GDK_BACKEND", "wayland,x11,*")
hl.env("QT_QPA_PLATFORM", "wayland;xcb")
hl.env("CLUTTER_BACKEND", "wayland")

-- Input method
hl.env("QT_IM_MODULE", "fcitx")
hl.env("XMODIFIERS", "@im,fcitx")

-- XDG
hl.env("XDG_CURRENT_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_TYPE", "wayland")

-- Qt
hl.env("QT_AUTO_SCREEN_SCALE_FACTOR", "1")
hl.env("QT_WAYLAND_DISABLE_WINDOWDECORATION", "1")
hl.env("QT_QPA_PLATFORMTHEME", "qt6ct")
hl.env("QT_QUICK_CONTROLS_STYLE", "org.hyprland.style")

-- Scaling (keep in sync with the monitor scale)
hl.env("GDK_SCALE", "1")
hl.env("QT_SCALE_FACTOR", "1")

-- Firefox / Electron
hl.env("MOZ_ENABLE_WAYLAND", "1")
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "auto")

----------------------------------------------------------------------------------
-- AUTOSTART
----------------------------------------------------------------------------------
hl.on("hyprland.start", function()
	hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")
	hl.exec_cmd("systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")

	hl.exec_cmd(scriptsDir .. "/Polkit.sh")

	hl.exec_cmd("fcitx5") -- japanese input
	hl.exec_cmd("flameshot")
	hl.exec_cmd("hyprctl setcursor Adwaita 64")

	-- clipboard manager
	hl.exec_cmd("wl-paste --type text --watch cliphist -max-items 99999999 store")
	hl.exec_cmd("wl-paste --type image --watch cliphist -max-items 99999999 store")

	-- hypridle is superseded by noctalia's built-in idle manager ([idle] in noctalia/settings.toml)
	hl.exec_cmd("noctalia")

	hl.exec_cmd(run .. " " .. term .. " -e tmux", { workspace = "special:terminal silent" })
	hl.exec_cmd(run .. ' zen-browser --no-remote -P "work"', { workspace = "1 silent" })
	hl.exec_cmd(run .. " slack", { workspace = "2 silent" })
	hl.exec_cmd(run .. ' zen-browser --no-remote -P "Default (release)"', { workspace = "4 silent" })
	hl.exec_cmd(run .. " telegram-desktop", { workspace = "5 silent" })
	-- hl.exec_cmd("anki",  { workspace = "7 silent" })
	-- hl.exec_cmd("steam", { workspace = "9 silent" })
end)

----------------------------------------------------------------------------------
-- DISPLAY
----------------------------------------------------------------------------------
hl.monitor({ output = one, mode = "3840x2160@120", position = "0x0", scale = 1 })
-- Samsung LS32AG55x, rotated 90° (portrait, 1440x2560 logical), right of the TV
hl.monitor({ output = "DP-2", mode = "2560x1440@165", position = "-1440x-500", scale = 1, transform = 1 })
-- hl.monitor({ output = one, mode = "2560x1440@165", position = "0x0", scale = 1 })
-- hl.monitor({ output = two, mode = "1920x1200@120", position = "-1920x1000", scale = 1 })

-- Any other output (including eDP-1) stays off.
hl.monitor({ output = "", disabled = true })

for i = 1, 8 do
	hl.workspace_rule({ workspace = tostring(i), monitor = one, default = (i == 1) or nil, persistent = true })
end
hl.workspace_rule({ workspace = "9", monitor = two, persistent = true })
hl.workspace_rule({ workspace = "10", monitor = two, persistent = true })

----------------------------------------------------------------------------------
-- DECORATIONS + SETTINGS
----------------------------------------------------------------------------------
hl.curve("myBezier", { type = "bezier", points = { { 0, 1 }, { 0, 1 } } })

hl.animation({ leaf = "windows", enabled = true, speed = 4, bezier = "myBezier", style = "popin 80%" })
hl.animation({ leaf = "windowsOut", enabled = true, speed = 4, bezier = "default", style = "popin 90%" })
hl.animation({ leaf = "fade", enabled = true, speed = 4, bezier = "default" })
hl.animation({ leaf = "workspaces", enabled = true, speed = 4, bezier = "default" })
hl.animation({ leaf = "specialWorkspace", enabled = true, speed = 4, bezier = "default", style = "slidevert" })

hl.config({
	animations = { enabled = true },

	general = {
		layout = "dwindle",
		border_size = 1,
		gaps_in = 3,
		gaps_out = 0,
		resize_on_border = false,
		col = {
			active_border = "rgba(CCCCCC55)",
			inactive_border = "rgba(00000000)",
		},
	},

	decoration = {
		rounding = 0,
		active_opacity = 1,
		inactive_opacity = 1,
		fullscreen_opacity = 1,
		dim_inactive = false,
		dim_strength = 0.4,

		shadow = {
			enabled = false,
			range = 8,
			render_power = 1, -- was 0, below the allowed 1-4 (shadows are off anyway)
			color = "rgba(00000055)",
		},

		blur = {
			enabled = true,
			size = 5,
			passes = 3,
			new_optimizations = true,
		},
	},

	group = {
		col = { border_active = color15 },
		groupbar = { col = { active = color0 } },
	},

	dwindle = {
		preserve_split = true,
		special_scale_factor = 0.97,
	},

	master = {
		new_status = "master",
		new_on_top = true,
		mfact = 0.5,
	},

	input = {
		kb_layout = "us,ru",
		kb_options = "grp:win_space_toggle",
		kb_model = "pc105",

		repeat_delay = 250,
		repeat_rate = 50,
		special_fallthrough = true,
		follow_mouse = 1,
		sensitivity = 0, -- -1.0 - 1.0, 0 means no modification

		touchpad = {
			natural_scroll = true,
			tap_to_click = true,
			drag_lock = false,
			disable_while_typing = false,
			scroll_factor = 0.4,
		},
	},

	misc = {
		disable_hyprland_logo = true,
		disable_splash_rendering = true,
		mouse_move_enables_dpms = true,
		enable_swallow = false,
		swallow_regex = "^(kitty)$",
		focus_on_activate = false,
		initial_workspace_tracking = 0,
		middle_click_paste = true,
		enable_anr_dialog = true, -- Application not Responding
		anr_missed_pings = 15, -- default 1 is too low
	},

	binds = {
		workspace_back_and_forth = false,
		allow_workspace_cycles = true,
		pass_mouse_when_bound = false,
		workspace_center_on = 1,
	},

	xwayland = {
		enabled = true,
		force_zero_scaling = true,
	},

	render = {
		direct_scanout = 0,
	},

	cursor = {
		sync_gsettings_theme = true,
		no_hardware_cursors = 2,
		enable_hyprcursor = true,
		no_warps = true,
	},
})

hl.device({
	name = "syna8017:00-06cb:ceb2-touchpad",
	sensitivity = 0.25,
	accel_profile = "adaptive",
})

----------------------------------------------------------------------------------
-- KEYBINDS
----------------------------------------------------------------------------------
local exec = hl.dsp.exec_cmd
local function mod(...)
	return table.concat({ mainMod, ... }, " + ")
end

local LOCKED = { locked = true }
local LOCKED_REPEAT = { locked = true, repeating = true }
local REPEAT = { repeating = true }

-- General
hl.bind("CTRL + ALT + Delete", hl.dsp.exit())
hl.bind(mod("C"), hl.dsp.window.close())
hl.bind(mod("escape"), exec("noctalia msg session lock"))
hl.bind(mod("SHIFT", "P"), hl.dsp.window.pin())

-- Tiling
hl.bind(mod("F"), hl.dsp.window.float({ action = "toggle" }))
hl.bind(mod("M"), hl.dsp.window.fullscreen())
hl.bind(mod("SHIFT", "M"), hl.dsp.window.fullscreen({ mode = "maximized" }))

-- Cycle windows; if floating, bring to top
hl.bind("ALT + tab", function()
	hl.dispatch(hl.dsp.window.cycle_next())
	hl.dispatch(hl.dsp.window.bring_to_top())
end)

-- Hot keys
hl.bind("XF86AudioRaiseVolume", exec("wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+"), LOCKED_REPEAT)
hl.bind("XF86AudioLowerVolume", exec("wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"), LOCKED_REPEAT)
hl.bind("XF86AudioMute", exec("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"), LOCKED)
hl.bind("XF86AudioMicMute", exec("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"), LOCKED)
hl.bind("XF86Sleep", exec("systemctl suspend"), LOCKED)
hl.bind("XF86MonBrightnessUp", exec("brightnessctl set 5%+"), LOCKED_REPEAT)
hl.bind("XF86MonBrightnessDown", exec("brightnessctl set 5%-"), LOCKED_REPEAT)

hl.bind("XF86AudioPause", exec("playerctl play-pause"), LOCKED)
hl.bind("XF86AudioPlay", exec("playerctl play-pause"), LOCKED)
hl.bind("XF86AudioNext", exec("playerctl next"), LOCKED)
hl.bind("XF86AudioPrev", exec("playerctl previous"), LOCKED)
hl.bind("XF86AudioStop", exec("playerctl stop"), LOCKED)

-- Screenshots
hl.bind("SHIFT + Print", exec("flameshot gui"))
hl.bind(
	"Print",
	exec(
		"grimblast --freeze save area - | tee ~/Pictures/Screenshots/Clipboard/$(date +%Y%m%d-%H:%M:%S).png | swappy -f -;"
	)
)

-- Move windows / focus (hjkl)
for key, direction in pairs({ h = "left", l = "right", k = "up", j = "down" }) do
	hl.bind(mod("CTRL", key), hl.dsp.window.move({ direction = direction }))
	hl.bind(mod(key), hl.dsp.focus({ direction = direction }))
	-- hl.bind(mod("ALT", key), hl.dsp.window.swap({ direction = direction }))
end

-- Special workspaces
local specials = {
	{ name = "terminal", fkey = "F12", letter = "x" },
	{ name = "stuff", fkey = "F11", letter = "z" },
}
for _, s in ipairs(specials) do
	local target = "special:" .. s.name
	hl.bind(s.fkey, hl.dsp.workspace.toggle_special(s.name))
	hl.bind("ALT + " .. s.letter, hl.dsp.workspace.toggle_special(s.name))
	hl.bind("SHIFT + " .. s.fkey, hl.dsp.window.move({ workspace = target }))
	hl.bind("SHIFT + ALT + " .. s.letter, hl.dsp.window.move({ workspace = target }))
end

-- Workspaces 1-8: key codes (layout independent) and the qwe/asd/zx grid
local grid = { "Q", "W", "E", "A", "S", "D", "Z", "X" }
for i = 1, 8 do
	local code = "code:" .. (9 + i) -- code:10 = key 1

	hl.bind(mod(code), hl.dsp.focus({ workspace = i }))
	hl.bind(mod("SHIFT", code), hl.dsp.window.move({ workspace = i }))
	hl.bind(mod("CTRL", code), hl.dsp.window.move({ workspace = i, follow = false }))

	hl.bind(mod(grid[i]), hl.dsp.focus({ workspace = i }))
	hl.bind(mod("SHIFT", grid[i]), hl.dsp.window.move({ workspace = i }))
end

hl.bind(mod("SHIFT", "bracketleft"), hl.dsp.window.move({ workspace = "-1" }))
hl.bind(mod("SHIFT", "bracketright"), hl.dsp.window.move({ workspace = "+1" }))
hl.bind(mod("CTRL", "bracketleft"), hl.dsp.window.move({ workspace = "-1", follow = false }))
hl.bind(mod("CTRL", "bracketright"), hl.dsp.window.move({ workspace = "+1", follow = false }))

hl.bind(mod("period"), hl.dsp.focus({ workspace = "e+1" }))
hl.bind(mod("comma"), hl.dsp.focus({ workspace = "e-1" }))

-- Move/resize with mouse
hl.bind(mod("mouse:272"), hl.dsp.window.drag(), { mouse = true })
hl.bind(mod("mouse:273"), hl.dsp.window.resize(), { mouse = true })

hl.bind(mod("I"), exec("noctalia msg bar-toggle"))

-- Apps
hl.bind(
	"ALT + space",
	exec(
		'pkill rofi || true && rofi -show drun -modi drun,filebrowser,run,window -theme "'
			.. rofiDir
			.. '"/themes/launcher.rasi -drun-display-format "{name}" -display-drun "" -run-command "'
			.. run
			.. ' {cmd}"'
	)
)
hl.bind(mod("Return"), exec(scriptsDir .. "/RandomTerminal.sh " .. term)) -- floating terminal at random position

-- Features / extras
hl.bind(mod("V"), exec("~/work/custom/ssh-menu/ssh_menu.sh"))
hl.bind(mod("ALT", "D"), exec(scriptsDir .. "/RofiEmoji.sh"))
hl.bind(mod("ALT", "V"), exec(scriptsDir .. "/ClipManager.sh"))
hl.bind(mod("O"), exec(scriptsDir .. "/WallpaperSelect.sh"))
hl.bind(mod("R"), exec("noctalia msg config-reload"))

-- Desktop zoom (replaces the hyprctl keyword calls, which don't work with a Lua config)
local function setZoom(factor)
	hl.config({ cursor = { zoom_factor = math.max(1, math.min(10, factor)) } })
end
local function zoomBy(multiplier)
	return function()
		setZoom(hl.get_config("cursor.zoom_factor") * multiplier)
	end
end

hl.bind(mod("ALT", "mouse_down"), zoomBy(1.5))
hl.bind(mod("ALT", "mouse_up"), zoomBy(1 / 1.5))
hl.bind(mod("mouse_down"), zoomBy(1.1), REPEAT)
hl.bind(mod("KP_ADD"), zoomBy(1.1), REPEAT)
hl.bind(mod("mouse_up"), zoomBy(0.9), REPEAT)
hl.bind(mod("KP_SUBTRACT"), zoomBy(0.9), REPEAT)
hl.bind(mod("mouse:274"), function()
	setZoom(1)
end)

----------------------------------------------------------------------------------
-- WINDOW RULES
----------------------------------------------------------------------------------
local function tag(name, match, effects)
	local spec = effects or {}
	spec.tag, spec.match = name, match
	hl.window_rule(spec)
end

local SIZE_70_70 = "(monitor_w*0.7) (monitor_h*0.7)"
local SIZE_70_60 = "(monitor_w*0.7) (monitor_h*0.6)"
local SIZE_60_70 = "(monitor_w*0.6) (monitor_h*0.7)"
local SIZE_40_60 = "(monitor_w*0.4) (monitor_h*0.6)"

-- browser
tag("browser", { class = "^([Ff]irefox|org.mozilla.firefox|[Ff]irefox-esr|[Ff]irefox-bin)$" })
tag("browser", { class = "^([Gg]oogle-chrome(-beta|-dev|-unstable)?)$" })
tag("browser", { class = "^(chrome-.+-Default)$" }) -- Chrome PWAs
tag("browser", { class = "^([Cc]hromium)$" })
tag("browser", { class = "^([Mm]icrosoft-edge(-stable|-beta|-dev|-unstable))$" })
tag("browser", { class = "^(Brave-browser(-beta|-dev|-unstable)?)$" })
tag("browser", { class = "^([Tt]horium-browser|[Cc]achy-browser)$" })
tag("browser", { class = "^(zen-alpha|zen)$" })

-- notif
tag("notif", { class = "^(swaync-control-center|swaync-notification-window|swaync-client|class)$" })

-- terminal
tag("terminal", { class = "^(Alacritty|kitty|kitty-dropterm)$" })

-- email
tag("email", { class = "^([Tt]hunderbird|org.gnome.Evolution)$" })
tag("email", { class = "^(eu.betterbird.Betterbird)$" })

-- projects
tag("projects", { class = "^(codium|codium-url-handler|VSCodium)$" })
tag("projects", { class = "^(VSCode|code-url-handler)$" })
tag("projects", { class = "^(jetbrains-.+)$" }) -- JetBrains IDEs

-- screenshare
tag("screenshare", { class = "^(com.obsproject.Studio)$" })

-- IM
tag("im", { class = "^([Dd]iscord|[Ww]ebCord|[Vv]esktop)$" })
tag("im", { class = "^([Ff]erdium)$" }, { size = SIZE_60_70 })
tag("im", { class = "^([Ww]hatsapp-for-linux)$" })
tag("im", { class = "^(ZapZap|com.rtosta.zapzap)$" })
tag("im", { class = "^(org.telegram.desktop|io.github.tdesktop_x64.TDesktop)$" })
tag("im", { class = "^(teams-for-linux)$" })
tag("im", { class = "^(im.riot.Riot|Element)$" }) -- Element Matrix client

-- games
tag("games", { class = "^(gamescope)$" })
tag("games", { class = [[^(steam_app_\d+)$]] })

-- gamestore
tag("gamestore", { class = "^([Ss]team)$" })
tag("gamestore", { title = "^([Ll]utris)$" })
tag("gamestore", { class = "^(com.heroicgameslauncher.hgl)$" })

-- file-manager
tag("file-manager", { class = "^([Tt]hunar|org.gnome.Nautilus|[Pp]cmanfm-qt)$" })
tag("file-manager", { class = "^(app.drey.Warp)$" })

-- wallpaper / multimedia
tag("wallpaper", { class = "^([Ww]aytrogen)$" })
tag("multimedia", { class = "^([Aa]udacious)$" })
tag("multimedia_video", { class = "^([Mm]pv|vlc)$" })

-- settings
tag("settings", { title = "^(ROG Control)$" })
tag("settings", { class = "^(wihotspot(-gui)?)$" }) -- wifi hotspot
tag("settings", { class = "^([Bb]aobab|org.gnome.[Bb]aobab)$" }) -- disk usage analyzer
tag("settings", { class = "^(gnome-disks|wihotspot(-gui)?)$" })
tag("settings", { title = "(Kvantum Manager)" })
tag("settings", { class = "^(file-roller|org.gnome.FileRoller)$" }) -- archive manager
tag("settings", { class = "^(nm-applet|nm-connection-editor|blueman-manager)$" })
tag("settings", { class = "^(pavucontrol|org.pulseaudio.pavucontrol|com.saivert.pwvucontrol)$" }, { center = true })
tag("settings", { class = "^(qt5ct|qt6ct|[Yy]ad)$" })
tag("settings", { class = "(xdg-desktop-portal-gtk)" })
tag("settings", { class = "^(org.kde.polkit-kde-authentication-agent-1)$" })
tag("settings", { class = "^([Rr]ofi)$" })

-- viewer
tag("viewer", { class = "^(gnome-system-monitor|org.gnome.SystemMonitor|io.missioncenter.MissionCenter)$" }) -- system monitor
tag("viewer", { class = "^(evince)$" }) -- document viewer
tag("viewer", { class = "^(eog|org.gnome.Loupe)$" }) -- image viewer

-- Position
-- NOTE: Hyprland matches rules with RE2, which has no (?!...) lookahead, so this rule and the
-- three "float dialogs" rules further down never match. Carried over unchanged from
-- hyprland.conf; a working form would be title = "negative:.*[Tt]hunar.*".
hl.window_rule({ center = true, float = true, match = { class = "([Tt]hunar)", title = "^(?!.*[Tt]hunar).*$" } })
hl.window_rule({ center = true, match = { title = "^(Keybindings)$" } })

-- Don't idle while something is fullscreen
hl.window_rule({ idle_inhibit = "fullscreen", match = { fullscreen = true } })

-- Float
hl.window_rule({ float = true, size = SIZE_70_70, match = { tag = "wallpaper*" } })
hl.window_rule({ float = true, size = SIZE_70_70, match = { tag = "settings*" } })
hl.window_rule({ float = true, match = { tag = "viewer*" } })
hl.window_rule({ float = true, match = { class = "([Zz]oom|onedriver|onedriver-launcher)$" } })
hl.window_rule({ float = true, match = { class = "(org.gnome.Calculator)", title = "(Calculator)" } })
hl.window_rule({ float = true, match = { class = "^(mpv|com.github.rafostar.Clapper)$" } })
hl.window_rule({ float = true, match = { class = "^([Qq]alculate-gtk)$" } })
hl.window_rule({ float = true, pin = true, keep_aspect_ratio = true, match = { title = "^(Picture-in-Picture)$" } })

-- Float popups and dialogs
hl.window_rule({ float = true, center = true, match = { title = "^(Authentication Required)$" } })

-- Never match, see the NOTE above
hl.window_rule({
	float = true,
	match = { class = "(codium|codium-url-handler|VSCodium)", title = "^(?!.*codium|.*VSCodium).*$" },
})
hl.window_rule({
	float = true,
	match = { class = "^(com.heroicgameslauncher.hgl)$", title = "^(?!Heroic Games Launcher).*$" },
})
hl.window_rule({ float = true, match = { class = "^([Ss]team)$", title = "^(?!^([Ss]team)$).*$" } })

hl.window_rule({ float = true, size = SIZE_70_60, center = true, match = { title = "^(Add Folder to Workspace)$" } })
hl.window_rule({ float = true, size = SIZE_70_60, center = true, match = { title = "^(Save As)$" } })
hl.window_rule({ float = true, size = SIZE_40_60, center = true, match = { title = "^(floating)$" } })
hl.window_rule({ float = true, size = SIZE_40_60, center = true, match = { title = "^(flameshot)$" } })
hl.window_rule({ float = true, size = SIZE_70_60, match = { initial_title = "(Open Files)" } })

-- Size
hl.window_rule({ size = SIZE_60_70, match = { class = "^([Ww]hatsapp-for-linux|ZapZap|com.rtosta.zapzap)$" } })

-- Blur & borders
hl.window_rule({ no_blur = true, float = true, match = { tag = "games*" } })
hl.window_rule({ border_size = 2, match = { workspace = "special:terminal" } })

----------------------------------------------------------------------------------
-- LAYER RULES
----------------------------------------------------------------------------------
hl.layer_rule({ blur = true, ignore_alpha = 0, match = { namespace = "rofi" } })
hl.layer_rule({ blur = true, ignore_alpha = 0, match = { namespace = "waybar" } })
hl.layer_rule({ blur = true, ignore_alpha = 0, match = { namespace = "notifications" } })
hl.layer_rule({ blur = true, ignore_alpha = 0, match = { namespace = "swaync-notification-window" } })
hl.layer_rule({
	name = "noctalia",
	match = { namespace = "noctalia.*$" },
	ignore_alpha = 0.5,
	blur = true,
	blur_popups = true,
})
