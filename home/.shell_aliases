alias vim="nvim"
alias l="ls -lh"
alias ll="ls -lah"
alias lst="lsd --tree"

#-- Misc
alias mkdir="mkdir -pv"
alias ra='yazi'
alias y='yazi'
alias reload='source ~/.zshrc'
alias cm='cmatrix -u 3 -s'
alias cal='cal -3m'
alias penv=". ./venv/bin/activate"
alias fzf="fzf --style full --preview 'fzf-preview.sh {}' --bind 'focus:transform-header:file --brief {}'"

# ── Package management (macOS → Homebrew) ─────────────────────────────────────
# Maps the muscle-memory pacman shortcuts to brew equivalents
alias p='brew install'
alias pr='brew uninstall'
alias pu='brew upgrade'
alias pq='brew list'
alias pqi='brew info'

# ── Navigation ────────────────────────────────────────────────────────────────
alias packs="cd ~/work/nomad_packs"
alias cluster="cd ~/work/nomad-cluster"
alias src="cd ~/work/nodes_src"
alias proxy="cd ~/work/nodes-proxy"
alias iproxy="cd ~/work/internal-node-proxy"

# ── git ───────────────────────────────────────────────────────────────────────
alias gt="git tag"
alias gs="git status"
alias gch="git checkout"
alias greset="git reset --hard"
alias gl="git log --oneline --graph --all"
alias gmr="glab mr create --fill --fill-commit-body --remove-source-branch"
alias hey1000="hey -n 1000 -m POST -H"

gundo() { git reset --soft HEAD~${1:-1} }
gfix()  { git add . && git commit --amend --no-edit }
gfind() { git log --all --oneline --graph --decorate --grep="$1" }

# ── Docker ────────────────────────────────────────────────────────────────────
alias d="docker"
alias dps="docker ps -a"
alias dc="docker compose"
alias dcb="docker compose up -d --no-deps --build"
alias dcr="docker compose up -d --force-recreate"

# ── Kubernetes ────────────────────────────────────────────────────────────────
alias k="kubectl"
alias kd="kubectl describe"
alias kc="kubectl create"
alias ke="kubectl edit"
kg()  { kubectl get $1 -o wide }
kga() { kubectl get $1 -o wide --all-namespaces }
kns() { kubectl config set-context --current --namespace=$1 }
alias g='gcloud'

# ── Terraform ─────────────────────────────────────────────────────────────────
alias tf="terraform"

# ── Misc utils ────────────────────────────────────────────────────────────────
alias zshrc='vim ~/.zshrc'
alias pas='pass git pull; pass nksupport/all | less'
alias newpass='openssl rand -base64'
alias myip='curl -s ipinfo.io/ip'

# ── macOS-specific ────────────────────────────────────────────────────────────
# Open Finder in current directory (like thunar .)
alias files='open .'
# Flush DNS cache
alias flushdns='sudo dscacheutil -flushcache && sudo killall -HUP mDNSResponder'
# Show/hide hidden files in Finder
alias showfiles='defaults write com.apple.finder AppleShowAllFiles YES && killall Finder'
alias hidefiles='defaults write com.apple.finder AppleShowAllFiles NO  && killall Finder'
# Lock screen (like hyprland super+escape → hyprlock)
alias lock='pmset displaysleepnow'
