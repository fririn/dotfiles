# ──────────────────────────────────────────────────────────────────────────────
# Ghostty — macOS config
# ──────────────────────────────────────────────────────────────────────────────

# ── Appearance ────────────────────────────────────────────────────────────────
# theme sets base colours; explicit background/foreground override the theme
theme            = Flexoki Dark
background       = #000000
# foreground       = #cdd6f4
background-opacity      = 0.65
quit-after-last-window-closed = true
# Frosted-glass blur behind the transparent background (macOS vibrancy).
# Increase value for more blur; 20 is a good balance.
background-blur-radius  = 70
cursor-color     = #f5e0dc
# note: selection-background/foreground and cursor-text are not valid
# top-level Ghostty options (they come from the theme)

palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#a6adc8
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#cdd6f4

# ── Font ──────────────────────────────────────────────────────────────────────
font-family = FantasqueSansM Nerd Font Mono
font-size   = 18

# ── Window / padding ──────────────────────────────────────────────────────────
window-padding-x = 15
window-padding-y = 7
window-padding-balance = true
scrollback-limit       = 1000000

# ── macOS appearance ──────────────────────────────────────────────────────────
macos-titlebar-style        = hidden
macos-titlebar-proxy-icon   = hidden
macos-non-native-fullscreen = padded-notch

# ── Quick terminal (hyprland scratchpad terminal / F12 equivalent) ────────────
# Toggle with cmd+` from anywhere in macOS
quick-terminal-position           = top
quick-terminal-screen             = main
quick-terminal-animation-duration = 0.1


# ── CRITICAL: Option key as Alt/Meta ──────────────────────────────────────────
# Without this, Option+h sends "ˆ" instead of ESC-h, breaking ALL tmux
# Meta binds (M-h/j/k/l pane nav, M-H/J/K/L resize, M-m zoom, etc.)
macos-option-as-alt = left

# ── Keybinds ──────────────────────────────────────────────────────────────────
# Clear ALL Ghostty defaults so nothing intercepts tmux sequences.
keybind = clear

# keybind = performable:ctrl+shift+c=copy_to_clipboard
# keybind = performable:ctrl+shift+v=paste_from_clipboard
keybind = performable:super+c=copy_to_clipboard
keybind = performable:super+v=paste_from_clipboard

keybind = ctrl+super+r=reload_config
keybind = super+q=quit

keybind = global:f12=toggle_quick_terminal
keybind = global:alt+z=toggle_quick_terminal
quick-terminal-size = 100%
quick-terminal-position = bottom


# passthrough for CMD key to work with tmux
# Pane navigation - Cmd+hjkl → Alt+hjkl
keybind = super+h=text:\x1bh
keybind = super+j=text:\x1bj
keybind = super+k=text:\x1bk
keybind = super+l=text:\x1bl

# splits - cmd+ctrl+j/k -> super+alt+j/k
keybind = super+ctrl+k=text:\x1b\x0b
keybind = super+ctrl+j=text:\x1b\x0a

# Pane resize - Cmd+Shift+hjkl → Alt+HJKL
keybind = super+shift+h=text:\x1bH
keybind = super+shift+j=text:\x1bJ
keybind = super+shift+k=text:\x1bK
keybind = super+shift+l=text:\x1bL

# Zoom/maximise pane - Cmd+m → Alt+m
keybind = super+m=text:\x1bm

# Rotate layout - Cmd+o → Ctrl+Alt+o
keybind = super+o=text:\x1b\x0f

# Previous/next window - Cmd+ctrl+h/l → Ctrl+Alt+h / Ctrl+Alt+l
keybind = super+ctrl+h=text:\x1b\x08
keybind = super+ctrl+l=text:\x1b\x0c
