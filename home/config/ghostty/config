# ──────────────────────────────────────────────────────────────────────────────
# Ghostty — macOS config
# ──────────────────────────────────────────────────────────────────────────────

# ── Appearance ────────────────────────────────────────────────────────────────
# theme sets base colours; explicit background/foreground override the theme
theme            = Catppuccin Mocha
background       = #1e1e2e
foreground       = #cdd6f4
background-opacity      = 0.85
# Frosted-glass blur behind the transparent background (macOS vibrancy).
# Increase value for more blur; 20 is a good balance.
background-blur-radius  = 20
cursor-color     = #f5e0dc
# note: selection-background/foreground and cursor-text are not valid
# top-level Ghostty options (they come from the theme)

palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#a6adc8
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#cdd6f4

# ── Font ──────────────────────────────────────────────────────────────────────
font-family = FantasqueSansM Nerd Font Mono
font-size   = 18

# ── Window / padding ──────────────────────────────────────────────────────────
window-padding-x       = 7
window-padding-y       = 7
window-padding-balance = true
scrollback-limit       = 100000

# ── macOS appearance ──────────────────────────────────────────────────────────
macos-titlebar-style        = hidden
macos-titlebar-proxy-icon   = hidden
macos-non-native-fullscreen = padded-notch

# ── Quick terminal (hyprland scratchpad terminal / F12 equivalent) ────────────
# Toggle with cmd+` from anywhere in macOS
quick-terminal-position           = top
quick-terminal-screen             = main
quick-terminal-animation-duration = 0.15

# ── CRITICAL: Option key as Alt/Meta ──────────────────────────────────────────
# Without this, Option+h sends "ˆ" instead of ESC-h, breaking ALL tmux
# Meta binds (M-h/j/k/l pane nav, M-H/J/K/L resize, M-m zoom, etc.)
macos-option-as-alt = true

# ── Keybinds ──────────────────────────────────────────────────────────────────
# Clear ALL Ghostty defaults so nothing intercepts tmux sequences.
keybind = clear

# Clipboard
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

# Quick terminal toggle (cmd+` — like F12 scratchpad in hyprland)
keybind = super+grave_accent=toggle_quick_terminal

# Quit
keybind = super+q=quit

# ── tmux passthrough via ctrl+cmd ─────────────────────────────────────────────
# AeroSpace owns alt/option globally — alt+hjkl and alt+shift+hjkl are
# intercepted before reaching the terminal, breaking pane nav and resize.
# ctrl+cmd is free on macOS and not bound by AeroSpace.
#
# Ghostty intercepts ctrl+cmd+KEY and writes an ESC sequence to the PTY.
# tmux reads ESC+key as M-key (its Meta bind).
#
# Pane navigation  →  ctrl+cmd+hjkl  →  tmux M-h/j/k/l  →  select-pane
keybind = ctrl+super+h=text:\eh
keybind = ctrl+super+j=text:\ej
keybind = ctrl+super+k=text:\ek
keybind = ctrl+super+l=text:\el
#
# Pane resize  →  ctrl+cmd+shift+hjkl  →  tmux M-H/J/K/L  →  resize-pane
keybind = ctrl+super+H=text:\eH
keybind = ctrl+super+J=text:\eJ
keybind = ctrl+super+K=text:\eK
keybind = ctrl+super+L=text:\eL
#
# Pane zoom  →  ctrl+cmd+m  →  tmux M-m  →  resize-pane -Z
keybind = ctrl+super+m=text:\em
