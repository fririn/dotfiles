# ──────────────────────────────────────────────────────────────────────────────
# Ghostty — macOS config
# ──────────────────────────────────────────────────────────────────────────────

# ── Appearance ────────────────────────────────────────────────────────────────
theme                   = Catppuccin Mocha
background              = #1e1e2e
foreground              = #cdd6f4
background-opacity      = 0.85
selection-background    = #585b70
selection-foreground    = #cdd6f4
cursor-color            = #f5e0dc
cursor-text             = #1e1e2e

palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#a6adc8
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#cdd6f4

# ── Font ──────────────────────────────────────────────────────────────────────
font-family   = FantasqueSansM Nerd Font Mono
font-size     = 18

# ── Window / padding ──────────────────────────────────────────────────────────
window-padding-x        = 7
window-padding-y        = 7
window-padding-balance  = true
scrollback-limit        = 100000
audio-bell              = false

# ── macOS appearance ──────────────────────────────────────────────────────────
macos-titlebar-style          = hidden
macos-titlebar-proxy-icon     = hidden
macos-non-native-fullscreen   = padded-notch

# ── Quick terminal (hyprland scratchpad terminal / F12 equivalent) ────────────
# Toggle with cmd+` from anywhere in macOS
quick-terminal-position        = top
quick-terminal-screen          = main
quick-terminal-animation-duration = 0.15

# ── CRITICAL: Option key as Alt/Meta ──────────────────────────────────────────
# Without this, Option+h sends "ˆ" instead of ESC-h, breaking ALL tmux
# Meta binds (M-h/j/k/l pane nav, M-H/J/K/L resize, M-m zoom, etc.)
macos-option-as-alt = true

# ── Keybinds ──────────────────────────────────────────────────────────────────
# Clear ALL Ghostty defaults so nothing intercepts tmux sequences.
# Ghostty would otherwise grab ctrl+shift+*, cmd+t, cmd+d, etc.
keybind = clear

# Clipboard — use super (cmd) only, never ctrl/alt which belong to tmux
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

# Quick terminal toggle (cmd+` — like F12 scratchpad in hyprland)
keybind = super+grave_accent=toggle_quick_terminal

# Fullscreen
keybind = super+m=toggle_fullscreen

# Quit
keybind = super+q=quit
