# i3blocks configuration file.
# see "man i3blocks" for documentation.

separator=true
separator_block_width=20


[sway-focusedwindow]
command=~/.config/i3blocks/scripts/sway-focusedwindow/sway-focusedwindow
interval=persist

[volume]
command=~/.config/i3blocks/scripts/volume
interval=once
signal=10


[wireless]
command=~/.config/i3blocks/scripts/wireless
interval=5

[ethernet]
command=~/.config/i3blocks/scripts/ethernet
interval=5

[battery]
command=/usr/libexec/i3blocks/battery
interval=30
BAT_NUMBER=0

[powerprofile]
command=~/.config/i3blocks/scripts/powerprofile
interval=once

[load_average]
command=~/.config/i3blocks/scripts/la
interval=5

[memory]
command=/usr/libexec/i3blocks/memory
interval=5

[kubernetes]
command=~/.config/i3blocks/scripts/kubernetes/kubernetes
interval=10

