alias gldig="git log -p --format='%ncommit %H%nhttps://gitlab.com/$(git config --get remote.origin.url | sed 's/.*:\(.*\)\.git/\1/')/-/commit/%H%nAuthor: %an%nDate: %ad%n'"
alias gmr="glab mr create --fill --fill-commit-body --remove-source-branch"
alias hey1000="hey -n 1000 -m POST -H"

greset() {
  local count=${1:-1}
  echo "Rewinding $count commit(s) (keeping changes staged)..."
  git reset --soft HEAD~"$count"
}
gfix()  { git add . && git commit --amend --no-edit }
gfind() { git log --all --oneline --graph --decorate --grep="$1" }

